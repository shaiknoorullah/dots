# PATH contract (spec): local scripts, then pinned Nix tools, then the distro.
# Source rustup's env first (it prepends the cargo bin dir), then build the final order.
[ -r "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
typeset -U path PATH
path=($HOME/.local/bin(N-/) $HOME/.nix-profile/bin(N-/) $path)
# KUBECONFIG is discovered per machine by kube-discover.sh (this repo names no cluster); none found -> unset
[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/dots/kube.env" ] && . "${XDG_CONFIG_HOME:-$HOME/.config}/dots/kube.env"
export EDITOR=nvim VISUAL=nvim

# Ubuntu/Debian /etc/zsh/zshrc runs compinit before ~/.zshrc; zimfw/completion does it (with its own dumpfile), so skip the global one
skip_global_compinit=1
