#!/usr/bin/env bash
# dots-mail -- work mail on this machine: an encrypted local copy, kept in sync.
#
#   dots-mail init     first time: create the encrypted store; its key goes into the login keyring
#   dots-mail render   write the tool configs from ~/.config/dots-mail/account.conf
#   dots-mail mount    unlock the store at ~/Mail (the units do this at login)
#   dots-mail umount
#   dots-mail sync     every folder, then index (the timer runs this; push mail runs INBOX)
#   dots-mail status
#
# The store is gocryptfs. Its password lives only in the login keyring, which the login
# password unlocks, so the mail is readable while you are logged in (screen locked
# included) and is ciphertext otherwise -- including in every Timeshift snapshot, which
# copies the cipher directory and can never read the mount (a user FUSE mount is closed to
# root). The copy is a cache of the server: losing the key costs a resync, nothing more.
#
# Sign-in is OAuth2 through pizauth; the token cache lives inside the store. There is NO
# sending path: no SMTP is configured anywhere. Replies are saved to Drafts over IMAP and
# sent by the user from Outlook (decided 2026-10-29). Nothing here can send mail.
#
# account.conf is hand-written and unmanaged (it names the account):
#   MAIL_ADDRESS=you@example.com
#   MAIL_CLIENT_ID=<public OAuth client id the tenant already allows>
#   MAIL_IMAP_HOST=outlook.office365.com           (default)
#   MAIL_TENANT=common                             (default)
set -euo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
ACCOUNT="$CONF/dots-mail/account.conf"
CIPHER="${XDG_DATA_HOME:-$HOME/.local/share}/dots-mail/cipher"
MAIL="$HOME/Mail"
BOX="$MAIL/work"                 # maildir root, and the notmuch database
STATE="$MAIL/.state"             # pizauth's token dump, sync lock: inside the encryption
KEY=(service dots-mail key store)

die() { echo "dots-mail: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 not found (home-manager switch?)"; }

load() {
  [ -r "$ACCOUNT" ] || die "no $ACCOUNT (see the header of this script)"
  # shellcheck disable=SC1090
  . "$ACCOUNT"
  : "${MAIL_ADDRESS:?MAIL_ADDRESS missing in $ACCOUNT}"
  : "${MAIL_CLIENT_ID:?MAIL_CLIENT_ID missing in $ACCOUNT}"
  MAIL_IMAP_HOST="${MAIL_IMAP_HOST:-outlook.office365.com}"
  MAIL_TENANT="${MAIL_TENANT:-common}"
}

mounted() { mountpoint -q "$MAIL"; }

cmd_init() {
  need gocryptfs; need secret-tool
  if [ -f "$CIPHER/gocryptfs.conf" ]; then echo "store exists: $CIPHER"; return 0; fi
  mkdir -p "$CIPHER" "$MAIL"; chmod 700 "$CIPHER"
  if ! secret-tool lookup "${KEY[@]}" >/dev/null 2>&1; then
    head -c 48 /dev/urandom | base64 -w0 \
      | secret-tool store --label="dots-mail encrypted store" "${KEY[@]}"
  fi
  gocryptfs -init -q -extpass "secret-tool lookup ${KEY[*]}" "$CIPHER"
  # the master key opens the store even if the password is lost; keep it in the keyring
  # beside the password, never on screen or on disk in the clear
  secret-tool lookup "${KEY[@]}" | gocryptfs-xray -dumpmasterkey "$CIPHER/gocryptfs.conf" 2>/dev/null \
    | tr -d '\n' | secret-tool store --label="dots-mail store master key" service dots-mail key master
  echo "store created: $CIPHER (key in the login keyring)"
}

cmd_mount() {
  need gocryptfs; need secret-tool
  [ -f "$CIPHER/gocryptfs.conf" ] || die "no store; run: dots-mail init"
  mounted && return 0
  mkdir -p "$MAIL"
  secret-tool lookup "${KEY[@]}" >/dev/null 2>&1 || die "keyring locked or key missing"
  gocryptfs -q -noprealloc -extpass "secret-tool lookup ${KEY[*]}" "$CIPHER" "$MAIL"
  mkdir -p "$BOX" "$STATE"; chmod 700 "$STATE"
}

cmd_umount() { mounted || return 0; fusermount3 -u "$MAIL" 2>/dev/null || fusermount -u "$MAIL"; }

write() {   # path, from stdin; 0600, atomically
  local f=$1; mkdir -p "$(dirname "$f")"
  umask 077; cat > "$f.tmp"; mv -f "$f.tmp" "$f"
}

cmd_render() {
  load
  local pz="$HOME/.nix-profile/bin/pizauth"
  [ -x "$pz" ] || pz=pizauth
  write "$CONF/pizauth.conf" <<EOF
// generated by dots-mail render from $ACCOUNT; edit that, not this
account "work" {
  auth_uri = "https://login.microsoftonline.com/$MAIL_TENANT/oauth2/v2.0/authorize";
  token_uri = "https://login.microsoftonline.com/$MAIL_TENANT/oauth2/v2.0/token";
  client_id = "$MAIL_CLIENT_ID";
  // read and draft only: no SMTP.Send, so even a stolen token cannot send
  scopes = ["https://outlook.office365.com/IMAP.AccessAsUser.All", "offline_access"];
  login_hint = "$MAIL_ADDRESS";
}
auth_notify_cmd = "notify-send -a Mail -u critical 'Sign in to work mail' 'Opening the browser'; xdg-open \"\$PIZAUTH_URL\"";
token_event_cmd = "$pz dump > $STATE/pizauth.dump.tmp && mv -f $STATE/pizauth.dump.tmp $STATE/pizauth.dump";
EOF
  write "$CONF/isyncrc" <<EOF
# generated by dots-mail render; edit $ACCOUNT, not this
IMAPAccount work
Host $MAIL_IMAP_HOST
Port 993
TLSType IMAPS
User $MAIL_ADDRESS
AuthMechs XOAUTH2
PassCmd "$pz show work"
Timeout 60

IMAPStore work-remote
Account work

MaildirStore work-local
Path $BOX/
Inbox $BOX/INBOX
SubFolders Verbatim

Channel work
Far :work-remote:
Near :work-local:
# everything but the folders that are not mail
Patterns * !Calendar* !Contacts* !"Conversation History" !Journal !Notes !Tasks !Outbox !"Sync Issues*" !"RSS Feeds" !"RSS Subscriptions"
# flags and drafts go up; nothing is ever deleted or expunged on the server from here
Sync All
Create Near
Remove None
Expunge None
CopyArrivalDate yes
MaxSize 30m
SyncState *
EOF
  write "$CONF/goimapnotify/goimapnotify.yaml" <<EOF
# generated by dots-mail render; IMAP IDLE on INBOX, so new mail lands in seconds
configurations:
  - host: $MAIL_IMAP_HOST
    port: 993
    tls: true
    username: $MAIL_ADDRESS
    passwordCMD: $pz show work
    xoAuth2: true
    boxes:
      - mailbox: INBOX
        onNewMail: $HOME/.local/bin/dots-mail sync INBOX
        onNewMailPost: SKIP
EOF
  write "$CONF/notmuch/default/config" <<EOF
# generated by dots-mail render
[database]
path=$BOX
[user]
primary_email=$MAIL_ADDRESS
[new]
tags=new;
ignore=.mbsyncstate;.uidvalidity;.mbsyncstate.journal;.mbsyncstate.new;.mbsyncstate.lock
[search]
exclude_tags=deleted;spam;
[maildir]
synchronize_flags=true
EOF
  # until the triage rules (afew) exist, new mail simply lands in the inbox
  if [ ! -x "$BOX/.notmuch/hooks/post-new" ] && mounted; then
    mkdir -p "$BOX/.notmuch/hooks"
    write "$BOX/.notmuch/hooks/post-new" <<'EOF'
#!/bin/sh
# dots-mail: first-pass tagging; the triage rules replace this
notmuch tag +inbox -new -- tag:new
EOF
    chmod 700 "$BOX/.notmuch/hooks/post-new"
  fi
  echo "rendered: pizauth.conf isyncrc goimapnotify.yaml notmuch config"
}

cmd_sync() {
  need mbsync; need notmuch
  mounted || die "store not mounted"
  local what="work${1:+:$1}"
  exec 9>"$STATE/sync.lock"
  flock -n 9 || { [ -n "${1:-}" ] && flock 9 || exit 0; }   # a full sync already running covers it
  mbsync -c "$CONF/isyncrc" -q "$what"
  notmuch new --quiet
}

cmd_status() {
  if mounted; then echo "store    unlocked at $MAIL"; else echo "store    locked"; fi
  command -v pizauth >/dev/null && echo "sign-in  $(pizauth status 2>&1 | head -1)"
  if mounted && [ -d "$BOX/.notmuch/xapian" ]; then
    echo "index    $(notmuch count '*') messages, $(notmuch count tag:inbox and tag:unread) unread in inbox"
  fi
  systemctl --user --no-legend list-units 'dots-mail*' 2>/dev/null | awk '{print "unit     " $1, $3, $4}'
}

case "${1:-status}" in
  init) cmd_init ;;
  render) cmd_render ;;
  mount) cmd_mount ;;
  umount) cmd_umount ;;
  sync) shift; cmd_sync "${1:-}" ;;
  status) cmd_status ;;
  *) sed -n '2,10p' "$0"; exit 64 ;;
esac
