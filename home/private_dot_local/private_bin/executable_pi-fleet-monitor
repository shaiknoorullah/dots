#!/usr/bin/env bash
# pi-fleet-monitor — prints pi-agent + sub-branch status across a pi-agent fleet.
# Used as a UserPromptSubmit hook so Claude gets fresh pi state at every turn.
#
# Output format: JSON on stdout with `hookSpecificOutput.additionalContext` that
# Claude Code injects into the model context.
#
# Project-specific values (tmux panes, worktrees, branch, model names) are NOT in this public repo. They come from
# ${XDG_CONFIG_HOME:-~/.config}/pi-fleet/config.sh, hand-copied like ~/.secrets (docs/install.md). It is sourced
# as bash and sets:
#   PI_FLEET_PANES=(session:win.pane ...)     tmux panes running pi agents                     (required)
#   PI_FLEET_BASE_BRANCH=feat/...              branch the sub-branches are measured against    (required)
#   PI_FLEET_WORKTREES=(name ...)              worktree dirs under PI_FLEET_WORKTREE_ROOT       (optional)
#   PI_FLEET_WORKTREE_ROOT=$HOME/work          default $HOME/work
#   PI_FLEET_REGISTRY=/path/tickets.yaml       fleet registry (yq), skipped when unset/missing (optional)
#   PI_FLEET_MODEL_RE='model|proxy/name'       ERE: pi status-line text that marks a pane active (optional)
#   PI_FLEET_TAIL_SKIP_RE='model'              ERE: lines left out of the progress tail; default PI_FLEET_MODEL_RE
#   PI_FLEET_SESSION_PREFIX=fleet-             tmux sessions spawned by fleet-spawn.sh; default fleet-

set -euo pipefail

cfg="${XDG_CONFIG_HOME:-$HOME/.config}/pi-fleet/config.sh"
if [[ ! -r "$cfg" ]]; then
  echo "pi-fleet-monitor: $cfg not found; it holds the project-specific panes/worktrees (hand-copied, see docs/install.md)" >&2
  exit 1
fi
PI_FLEET_PANES=(); PI_FLEET_WORKTREES=(); PI_FLEET_BASE_BRANCH=""
# shellcheck source=/dev/null
. "$cfg"
[[ ${#PI_FLEET_PANES[@]} -gt 0 && -n "$PI_FLEET_BASE_BRANCH" ]] \
  || { echo "pi-fleet-monitor: $cfg must set PI_FLEET_PANES and PI_FLEET_BASE_BRANCH" >&2; exit 1; }

PANES_TO_CHECK=("${PI_FLEET_PANES[@]}")
FLEET_SESSION_PREFIX="${PI_FLEET_SESSION_PREFIX:-fleet-}"
BASE_BRANCH="$PI_FLEET_BASE_BRANCH"
WT_ROOT="${PI_FLEET_WORKTREE_ROOT:-$HOME/work}"
MODEL_RE="${PI_FLEET_MODEL_RE:-}"
TAIL_SKIP_RE="${PI_FLEET_TAIL_SKIP_RE:-$MODEL_RE}"

# Collect status
report=""

# --- pi panes ---
for pane in "${PANES_TO_CHECK[@]}"; do
  out=$(tmux-cli capture --pane="$pane" 2>/dev/null | tail -40 || true)
  [[ -z "$out" ]] && continue
  status=$(printf '%s\n' "$out" | grep -E '^(DONE|DONE_WITH_CONCERNS|BLOCKED|NEEDS_CONTEXT):' | tail -1 || true)
  ctx_line=$(printf '%s\n' "$out" | grep -oE '[0-9]+\.[0-9]+%/1\.0M' | tail -1 || true)
  # Active if any pi "chrome" signal is present: spinner, just-took-N time, tool-check, $-prompt, or pi model line
  is_active="no"
  if printf '%s\n' "$out" | grep -qE "(Working\.\.\.|Took [0-9]+\.[0-9]+s${MODEL_RE:+|$MODEL_RE}|^ \\\$\s|✓ |✗ |LSP: (idle|busy))"; then
    is_active="yes"
  fi
  if [[ -n "$status" ]]; then
    report+="$pane  STATUS=$status  ctx=$ctx_line"$'\n'
  elif [[ "$is_active" == "yes" ]]; then
    # Grab last meaningful non-chrome line as a progress tail
    tail_line=$(printf '%s\n' "$out" | grep -vE "^[─\s]*\$${TAIL_SKIP_RE:+|$TAIL_SKIP_RE}|LSP:|^[0-9\.]+%/|^\$" | tail -1 | sed 's/^ *//' | cut -c1-100)
    report+="$pane  active  ctx=$ctx_line  tail=\"$tail_line\""$'\n'
  else
    report+="$pane  idle/unknown  ctx=$ctx_line"$'\n'
  fi
done

# --- fleet-* sessions (spawned via fleet-spawn.sh) ---
fleet_sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep "^$FLEET_SESSION_PREFIX" || true)
for sess in $fleet_sessions; do
  first_pane=$(tmux list-panes -t "$sess" -F '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null | head -1)
  [[ -z "$first_pane" ]] && continue
  out=$(tmux-cli capture --pane="$first_pane" 2>/dev/null | tail -30 || true)
  status=$(printf '%s\n' "$out" | grep -E '^(DONE|DONE_WITH_CONCERNS|BLOCKED|NEEDS_CONTEXT):' | tail -1 || true)
  if [[ -n "$status" ]]; then
    report+="$sess  $status"$'\n'
  fi
done

# --- sub-branch commit deltas ---
for wt in "${PI_FLEET_WORKTREES[@]}"; do
  dir="$WT_ROOT/$wt"
  [[ -d "$dir/.git" || -f "$dir/.git" ]] || continue
  branch=$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
  [[ -z "$branch" ]] && continue
  if [[ "$branch" == "$BASE_BRANCH" ]]; then
    ahead=$(git -C "$dir" rev-list --count origin/"$BASE_BRANCH"..HEAD 2>/dev/null || echo "?")
    dirty=$(git -C "$dir" status --short 2>/dev/null | wc -l)
    report+="$wt  $branch  ahead-of-origin=$ahead  dirty=$dirty"$'\n'
  else
    ahead_base=$(git -C "$dir" rev-list --count "$BASE_BRANCH".."$branch" 2>/dev/null || echo "?")
    dirty=$(git -C "$dir" status --short 2>/dev/null | wc -l)
    last=$(git -C "$dir" log -1 --format='%h %s' "$branch" 2>/dev/null || true)
    report+="$wt  $branch  ahead-base=$ahead_base  dirty=$dirty  last=$last"$'\n'
  fi
done

# Fleet registry snapshot (if registry exists)
reg="${PI_FLEET_REGISTRY:-}"
if [[ -n "$reg" && -f "$reg" ]]; then
  summary=$(yq -r '.tickets | to_entries | map("\(.key): \(.value.state)") | .[]' "$reg" 2>/dev/null | tr '\n' ' | ' || true)
  report+="fleet-registry: $summary"$'\n'
fi

if [[ -z "${report// }" ]]; then
  report="(no pi agents active, no sub-branches ahead)"$'\n'
fi

# Emit JSON for Claude Code hook consumption
ctx=$(printf 'pi-fleet status:\n%s' "$report")
jq -n --arg c "$ctx" '{
  hookSpecificOutput: {
    hookEventName: "UserPromptSubmit",
    additionalContext: $c
  }
}'
