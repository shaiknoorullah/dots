#!/usr/bin/env bash
# units hash: {{ output "sh" "-c" (printf "cd %s/private_dot_config/systemd/private_user && find . -type f | LC_ALL=C sort | xargs cat | sha256sum" .chezmoi.sourceDir) | trim }}
# data: multiplexer={{ .multiplexer }} timetrack={{ .timetrack }} orgManaged={{ get . "orgManaged" | default false }}
set -uo pipefail
if ! systemctl --user show-environment >/dev/null 2>&1; then
  echo "systemd: no user manager reachable (ssh without a session?); skipping unit enable" >&2
  exit 0
fi
systemctl --user daemon-reload
systemctl --user enable --now adhd-prayer-times.timer adhd-salah-schedule.timer aw-server.service awatcher.service
# Kube tunnel units are copied by hand (docs/install.md §2), never shipped here, so enable whatever this machine
# was given. Each unit's own ConditionPathExists keeps it skipped until its secret is in place. reverse-tunnel.service
# IS shipped by dots, so it is excluded here and enabled per profile below.
for f in "${XDG_CONFIG_HOME:-$HOME/.config}"/systemd/user/*-tunnel.service; do
  [ -e "$f" ] || continue
  u=${f##*/}
  [ "$u" = reverse-tunnel.service ] && continue
  systemctl --user enable --now "$u" 2>/dev/null || true
done
{{- if get . "orgManaged" | default false }}
# orgManaged: no personal reverse tunnel here (stop it if an earlier apply enabled it)
systemctl --user disable --now reverse-tunnel.service 2>/dev/null || true
# personal window-title capture never runs on a work machine (stop it if an earlier apply enabled it)
systemctl --user disable --now capture-window.service 2>/dev/null || true
{{- else }}
# window-focus capture (raw titles) on personal machines only; capture-mirror reads what it writes
systemctl --user enable --now capture-window.service
# personal reverse tunnel (autossh); skipped until the hand-copied ~/.config/reverse-tunnel.env exists, or while the old system unit is installed
systemctl --user enable --now reverse-tunnel.service
{{- end }}
systemctl --user enable --now dots-ops-fallback.timer
systemctl --user enable --now dots-ops-disk-watch.timer
systemctl --user enable --now dots-ops-net-watch.timer dots-ops-containers.timer dots-ops-k8s-health.timer
{{- if not (get . "orgManaged" | default false) }}
systemctl --user enable --now dots-ops-dots-update.timer
systemctl --user enable --now dots-ops-backup-watch.timer dots-ops-backup-check.timer
systemctl --user enable --now dots-ops-pins-check.timer
{{- end }}
systemctl --user enable --now dots-ops-relay.path dots-ops-relay.service
# work mail (dots-mail): each unit is a no-op until `dots-mail init` has created the store
systemctl --user enable --now dots-mail-mount.service dots-mail-auth.service dots-mail-push.service dots-mail-sync.timer 2>/dev/null || true
systemctl --user enable --now dots-ops-vault-backup.timer dots-ops-vault-watch.timer
# Capture is NOT behind .timetrack. That flag gates the old timetrack-* units, and it has
# been false since the package was written -- which is one half of why the predecessor
# recorded nothing for months. The job degrades safely on a machine without the binary
# (it reports warn and returns), so gating it buys nothing and costs the whole record.
systemctl --user enable --now dots-ops-timetrack-capture.timer
{{- if .timetrack }}
systemctl --user enable --now timetrack-logind.service
# The reaper FIRST, deliberately. timetrack-panel refuses to draw a keyboard-grabbing
# modal while timetrack-deadman.timer is inactive, so starting them the other way round
# would make every panel refuse for as long as the gap lasted -- and worse, an apply that
# failed between the two lines would leave enforcement armed with nothing to stop it.
systemctl --user enable --now timetrack-deadman.timer
# clockd is Restart=always, so enabling it without the binary installed produces a restart
# loop in the journal rather than a clear error. The guard keeps the failure legible.
if [ -x "$HOME/.nix-profile/bin/timetrack" ]; then
  systemctl --user enable --now timetrack-clockd.service
  # after the deadman timer above: its panels refuse to draw without the reaper
  systemctl --user enable --now timetrack-away.service
else
  echo "systemd: timetrack binary absent; clockd left disabled (nix run .#homeConfigurations...)" >&2
fi
{{- end }}
# rollup/sync units are gone with the modules they ran; disable any left from an older apply
systemctl --user disable --now timetrack-rollup.timer timetrack-sync.timer 2>/dev/null || true
{{- if eq .multiplexer "tmux" }}
systemctl --user enable --now tmux.service; systemctl --user disable --now herdr.service 2>/dev/null || true
{{- else }}
systemctl --user enable --now herdr.service; systemctl --user disable --now tmux.service 2>/dev/null || true
{{- end }}
exit 0
