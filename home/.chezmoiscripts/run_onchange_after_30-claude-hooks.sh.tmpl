#!/usr/bin/env bash
# Register the ticket-binding hook in ~/.claude/settings.json.
#
# That file is HAND-MAINTAINED and chezmoi does not manage it -- it holds the user's model
# routing, permissions, plugins and output style, none of which belongs in a public repo.
# So this script merges in exactly two entries and leaves everything else byte-identical:
# it never writes a settings file it did not first parse, and it refuses to install a
# result that does not parse back.
#
# Why a script and not a managed file: the alternative is for chezmoi to own the whole of
# settings.json, which would mean either publishing the user's permissions list or
# rendering it from template data -- and either way an apply would overwrite hand edits
# made between applies. Merging is the only form that cannot lose their work.
#
# Not gated on .timetrack, for the same reason the capture job is not: the hook writes
# NOTHING to the payroll database. It labels a herdr pane with the ticket the user named,
# which is display metadata with a 90-minute ttl. If clockd never runs, nothing reads it.
# Gating it would buy no privacy and would guarantee that the binding was missing on the
# first day the clock went live -- which is the day the attribution matters most.
set -uo pipefail
S="$HOME/.claude/settings.json"
HOOK="$HOME/.local/bin/timetrack-ticket-hook"
# live state in the onchange hash: how many of our entries the settings file carries, so
# this re-asserts if an edit drops them and stays silent while they are already there.
# Deliberately NOT the file's own hash -- settings.json is edited by hand often, and
# hashing all of it would leave this script permanently pending in `chezmoi status` for
# reasons that have nothing to do with the hook.
# live: {{ output "sh" "-c" "f=\"$HOME/.claude/settings.json\"; [ -f \"$f\" ] && grep -c timetrack-ticket-hook \"$f\" || echo absent" | trim }}

[ -f "$S" ] || { echo "claude-hooks: $S does not exist; skipping (re-run after first launch)" >&2; exit 0; }
[ -x "$HOOK" ] || { echo "claude-hooks: $HOOK is not executable; skipping" >&2; exit 0; }
command -v python3 >/dev/null || { echo "claude-hooks: no python3" >&2; exit 0; }

CLAUDE_SETTINGS="$S" CLAUDE_HOOK="$HOOK" python3 - <<'PY'
import json
import os
import shutil
import sys

path, hook = os.environ["CLAUDE_SETTINGS"], os.environ["CLAUDE_HOOK"]
raw = open(path, encoding="utf-8").read()
try:
    d = json.loads(raw)
except ValueError as e:
    # Refuse rather than repair. A settings file that does not parse is a problem for its
    # owner to look at, and rewriting one would destroy whatever they were mid-edit on.
    sys.exit(f"claude-hooks: {path} is not valid JSON ({e}); left untouched")

MINE = "timetrack-ticket-hook"
WANT = {"UserPromptSubmit": "prompt", "SessionStart": "session"}
hooks = d.setdefault("hooks", {})
changed = []
for event, action in WANT.items():
    entries = hooks.setdefault(event, [])
    cmd = {"type": "command", "command": f"{hook} {action}", "timeout": 5}
    # Our own entry gets replaced in place; every other entry in the list -- herdr's
    # SessionStart reporter, the notification hook -- is preserved exactly as found.
    for entry in entries:
        inner = entry.get("hooks") or []
        mine = [h for h in inner if MINE in str(h.get("command", ""))]
        if mine:
            if mine[0] != cmd:
                inner[inner.index(mine[0])] = cmd
                changed.append(f"{event} (updated)")
            break
    else:
        entries.append({"hooks": [cmd]})
        changed.append(f"{event} (added)")

if not changed:
    print("claude-hooks: already registered")
    sys.exit(0)

out = json.dumps(d, indent=2) + "\n"
json.loads(out)                      # must parse back before it is allowed near the file
shutil.copy2(path, path + ".dots-bak")
tmp = path + ".dots-tmp"
with open(tmp, "w", encoding="utf-8") as fh:
    fh.write(out)
os.replace(tmp, path)                # atomic: Claude never reads a half-written settings
print("claude-hooks: " + ", ".join(changed) + f" (backup {path}.dots-bak)")
PY
exit 0
