{
  "layer": "top",
  "position": "top",
  "height": 30,
  // spacing 0 on purpose: the right and centre modules are drawn as ONE slab each (shared
  // background, hairline dividers, rounded only at the ends), and waybar's `spacing` would
  // punch transparent gaps through the middle of that slab. All gaps now come from CSS
  // margins, so there is a single place that decides how far apart anything sits.
  "spacing": 0,
  "modules-left": ["ext/workspaces"],
  "modules-center": ["clock", "custom/salah"],
  "modules-right": ["custom/tracking", "custom/project", "custom/kube", "custom/ops", "custom/ctx", "idle_inhibitor", "custom/notification", "wireplumber", "group/tray"],
  // ext/workspaces, not hyprland/workspaces: waybar's hyprland click sends the legacy
  // `dispatch workspace <n>`, which Hyprland 0.56 wraps as Lua (`hl.dispatch(workspace 3)`)
  // and rejects, so clicking did nothing. This activates over ext-workspace-v1 instead.
  "ext/workspaces": { "on-click": "activate", "format": "{name}" },
  "clock": { "format": "{:%a %d %b  %H:%M}", "tooltip-format": "<tt>{calendar}</tt>" },
  "custom/salah":    { "exec": "{{ .chezmoi.homeDir }}/.local/bin/waybar-salah.sh",    "return-type": "json", "interval": 60, "on-click": "ghostty --class=dots.otter --gtk-single-instance=false --config-file={{ .chezmoi.homeDir }}/.config/ghostty/popup -e ~/.local/bin/adhd-focus.sh status" },
  "custom/tracking": { "exec": "{{ .chezmoi.homeDir }}/.local/bin/waybar-tracking.sh", "return-type": "json", "interval": 15, "on-click": "ghostty --class=dots.tasktui --gtk-single-instance=false --config-file={{ .chezmoi.homeDir }}/.config/ghostty/popup-tasktui -e ~/.local/bin/tw-tui" },
  "custom/project":  { "exec": "{{ .chezmoi.homeDir }}/.local/bin/waybar-project.sh",  "return-type": "json", "interval": 2, "on-click": "ghostty --class=dots.otter --gtk-single-instance=false --config-file={{ .chezmoi.homeDir }}/.config/ghostty/popup -e otter-launcher pj" },
  "custom/kube":     { "exec": "{{ .chezmoi.homeDir }}/.local/bin/waybar-kube.sh",     "return-type": "json", "interval": 30, "on-click": "ghostty --class=dots.otter --gtk-single-instance=false --config-file={{ .chezmoi.homeDir }}/.config/ghostty/popup -e k9s" },
  "custom/ops":      { "exec": "{{ .chezmoi.homeDir }}/.local/bin/dots-ops waybar",         "return-type": "json", "interval": 30, "signal": 9, "on-click-right": "{{ .chezmoi.homeDir }}/.local/bin/dots-ops perf-mode", "on-click": "ghostty --class=dots.ops --gtk-single-instance=false --config-file={{ .chezmoi.homeDir }}/.config/ghostty/popup -e ~/.local/bin/dots-ops status" },
  "custom/ctx":      { "exec": "{{ .chezmoi.homeDir }}/.local/bin/waybar-ctx.sh",      "return-type": "json", "interval": 30, "signal": 8, "on-click": "{{ .chezmoi.homeDir }}/.local/bin/waybar-ctx.sh cycle" },
  // icon comes from CSS -gtk-icontheme(); `states` is what gives the stylesheet a
  // class per volume band, since a label can hold text but not an SVG.
  // Muted drops the percentage entirely — the number is noise once nothing is audible — and
  // carries a single space so the module survives the empty-label hide (see style.css).
  // Scroll adjusts volume: the icon is already under the pointer, so asking for a click and
  // a keyboard key to change it was the odd part.
  "wireplumber": { "format": "{volume}%", "format-muted": " ", "states": { "high": 66, "medium": 33, "low": 1, "off": 0 },
                   "on-click": "swayosd-client --output-volume mute-toggle",
                   "on-scroll-up": "swayosd-client --output-volume raise",
                   "on-scroll-down": "swayosd-client --output-volume lower",
                   "tooltip-format": "{volume}% on {desc}" },
  // Caffeine: inhibits idle/lock while activated.
  "idle_inhibitor": { "format": " ",
                      "tooltip-format-activated": "caffeine on — idle and lock inhibited",
                      "tooltip-format-deactivated": "caffeine off — normal idle and lock" },
  // swaync: icon + unread badge. Left click opens the panel, right click toggles do-not-disturb.
  // jq blanks the count when there is nothing unread, so the bar shows a bare bell rather than "0".
  "custom/notification": {
    "return-type": "json", "escape": true, "exec-if": "command -v swaync-client",
    "exec": "swaync-client -swb | jq --unbuffered -c 'if .alt == \"none\" then .text = \"\" else .text = \" \" + .text end'",
    "format": " {text}",
    "on-click": "swaync-client -t -sw", "on-click-right": "swaync-client -d -sw" },
  // The tray is tucked into a drawer: the bar shows one icon, the items slide out on hover.
  // (swaync cannot host it — it is not a StatusNotifierItem host and has no tray widget,
  // its widgets being title/dnd/label/mpris/menubar/buttons-grid/slider/volume/backlight/
  // inhibitors/notifications. This is the closest thing to keeping it off the bar.)
  "group/tray": {
    "orientation": "inherit",
    "drawer": { "transition-duration": 250, "children-class": "tray-item", "transition-left-to-right": false },
    "modules": ["custom/tray-toggle", "tray"] },
  "custom/tray-toggle": { "format": " ", "tooltip-format": "tray — hover to expand" },
  "tray": { "spacing": 8 }
}
