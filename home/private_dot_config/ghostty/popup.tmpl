# Popup windows (otter, yazi, clipse, wallpaper, keyhelp, ...). Invoked with
# --gtk-single-instance=false so they get their own process + this config.
config-file = {{ .chezmoi.homeDir }}/.config/ghostty/config
window-padding-x = 12
window-padding-y = 12
window-width = 90
window-height = 28
window-save-state = never
background-opacity = 0.85
background-image = {{ .chezmoi.homeDir }}/.config/otter-launcher/images/otter-bg.png
background-image-fit = cover
background-image-opacity = 0.3
scrollback-limit = 0
bell-features = no-audio
