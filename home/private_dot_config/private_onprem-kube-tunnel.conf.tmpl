# Ansible managed
# Read by kube-tunnel.sh. HOST order is preference order; any one of them can carry every forward.
# Both cluster APIs ride the SAME ssh process: one forward for kubectl/helm, one for talosctl. Talos
# proxies `-n <node>` through whichever endpoint you reach, so ONE Talos forward serves every node.
FORWARD=6443 10.10.10.10:6443
FORWARD=50000 10.10.10.11:50000
KNOWN_HOSTS={{ .chezmoi.homeDir }}/work/ovh-nodec/ansible/files/onprem-pve-known_hosts
USER=root
HOST=192.168.100.130 {{ .chezmoi.homeDir }}/.ssh/onprem-l01-bootstrap
HOST=192.168.100.131 {{ .chezmoi.homeDir }}/.ssh/onprem-xl02-bootstrap
HOST=192.168.100.132 {{ .chezmoi.homeDir }}/.ssh/onprem-xl01-bootstrap
