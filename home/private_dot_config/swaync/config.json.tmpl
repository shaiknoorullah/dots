{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "control-center-positionX": "right",
  "control-center-positionY": "top",
  "control-center-width": 440,
  "control-center-height": 600,
  "control-center-margin-top": 14,
  "control-center-margin-right": 14,
  "control-center-margin-bottom": 14,
  "control-center-margin-left": 0,
  "layer-shell": true,
  "layer-shell-cover-screen": false,
  "cssPriority": "user",
  "notification-window-width": 440,
  "notification-icon-size": 48,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "notification-grouping": true,
  "notification-inline-replies": false,
  "image-visibility": "when-available",
  "relative-timestamps": true,
  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "transition-time": 200,
  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "scripts": {
    "claude-focus": {
      "exec": "{{ .chezmoi.homeDir }}/.config/dots-mux/claude-focus.sh",
      "app-name": "Claude Code",
      "run-on": "action"
    },
    "dots-sound": {
      "exec": "dots-sound message",
      "run-on": "receive"
    }
  },
  "text-empty": "Nothing waiting",
  "widgets": [
    "title",
    "dnd",
    "mpris",
    "buttons-grid",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear all"
    },
    "dnd": {
      "text": "Do not disturb"
    },
    "mpris": {
      "image-size": 60,
      "image-radius": 9
    },
    "buttons-grid": {
      "actions": [
        { "label": "Lock",    "command": "hyprlock" },
        { "label": "Suspend", "command": "systemctl suspend" }
      ]
    },
    "notifications": {
      "vexpand": true
    }
  }
}
