# otter-launcher - banner-top otter (Dracula). Generated by build_otter.py.
[general]
default_module = "ws"
vi_mode = false
loop_mode = false
esc_to_abort = true
cheatsheet_entry = "?"
cheatsheet_viewer = "less -R; clear"
delay_startup = 30

[interface]
suggestion_mode = "list"
suggestion_lines = 12
customized_list_order = true
header_cmd = "$HOME/.config/otter-launcher/scripts/otter-header.sh"
header_cmd_trimmed_lines = 0
header = "\n  \u001b[38;2;189;147;249m❯\u001b[0m "
separator = ""
footer = "\n  \u001b[38;2;98;114;164m──────────────────────────────────────────────────────────\u001b[0m\n  \u001b[38;2;189;147;249m↑↓\u001b[38;2;98;114;164m move   \u001b[38;2;189;147;249m⏎\u001b[38;2;98;114;164m run   \u001b[38;2;189;147;249m⇥\u001b[38;2;98;114;164m complete   \u001b[38;2;189;147;249m?\u001b[38;2;98;114;164m cheatsheet\u001b[0m"
place_holder = "type a prefix…"
prefix_padding = 3
list_prefix = "     "
selection_prefix = "   \u001b[38;2;255;121;198m▌\u001b[0m "
prefix_color = "\u001b[38;2;189;147;249m"
description_color = "\u001b[38;2;248;248;242m"
place_holder_color = "\u001b[38;2;98;114;164m"
cursor_shape = 6

[[modules]]
description = "  project context"
prefix = "c"
cmd = "{{ .chezmoi.homeDir }}/.local/bin/ctx '{}'"
with_argument = true
unbind_proc = true

[[modules]]
description = "  web search"
prefix = "ws"
cmd = "xdg-open 'https://duckduckgo.com/?q={}'"
with_argument = true
url_encode = true
unbind_proc = true

[[modules]]
description = "  shell"
prefix = "sh"
cmd = "ghostty --wait-after-command=true -e sh -c '{}'"
with_argument = true
unbind_proc = true

[[modules]]
description = "  wallpaper picker"
prefix = "wp"
cmd = "ghostty --class=dots.wallpaper --gtk-single-instance=false --config-file={{ .chezmoi.homeDir }}/.config/ghostty/popup -e {{ .chezmoi.homeDir }}/.local/bin/wallpaper"
unbind_proc = true

[[modules]]
description = "  bluetooth"
prefix = "bt"
cmd = "ghostty --class=dots.bluetuith --gtk-single-instance=false --config-file={{ .chezmoi.homeDir }}/.config/ghostty/popup-bluetuith -e bluetuith"
unbind_proc = true

[[modules]]
description = "  apps"
prefix = "app"
cmd = "{{ .chezmoi.homeDir }}/.config/otter-launcher/scripts/otter-app.sh"

[[modules]]
description = "  windows"
prefix = "win"
cmd = "{{ .chezmoi.homeDir }}/.config/otter-launcher/scripts/otter-win.sh"

[[modules]]
description = "  run"
prefix = "run"
cmd = "{{ .chezmoi.homeDir }}/.config/otter-launcher/scripts/otter-run.sh"

[[modules]]
description = "  power"
prefix = "pw"
cmd = "{{ .chezmoi.homeDir }}/.config/otter-launcher/scripts/otter-power.sh"

[[modules]]
description = "  media"
prefix = "md"
cmd = "{{ .chezmoi.homeDir }}/.config/otter-launcher/scripts/otter-media.sh"

[[modules]]
description = "  youtube music"
prefix = "ym"
cmd = "{{ .chezmoi.homeDir }}/.config/otter-launcher/scripts/otter-ytm.sh"

[[modules]]
description = "  projects"
prefix = "pj"
cmd = "{{ .chezmoi.homeDir }}/.config/otter-launcher/scripts/otter-projects.sh"

[[modules]]
description = "  tmux"
prefix = "tm"
cmd = "{{ .chezmoi.homeDir }}/.config/otter-launcher/scripts/otter-tmux.sh"

[[modules]]
description = "  obsidian"
prefix = "ob"
cmd = "{{ .chezmoi.homeDir }}/.config/otter-launcher/scripts/otter-obsidian.sh"

[[modules]]
description = "  zen tabs"
prefix = "zt"
cmd = "{{ .chezmoi.homeDir }}/.config/otter-launcher/scripts/otter-tabs.sh"

[[modules]]
description = "  git identity"
prefix = "git"
cmd = "{{ .chezmoi.homeDir }}/.config/otter-launcher/scripts/otter-git.sh"

[[modules]]
description = "  bookmarks"
prefix = "bm"
