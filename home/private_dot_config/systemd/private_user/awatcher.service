[Unit]
Description=ActivityWatch awatcher (window + AFK, Wayland)
Requires=aw-server.service
After=aw-server.service

[Service]
Type=simple
ExecStart=%h/.nix-profile/bin/awatcher
Restart=on-failure
RestartSec=5

# Without this the unit is `static`: `enable --now` starts it once and it never comes
# back after a reboot, silently ending window/AFK capture. aw-server.service uses the
# same target.
[Install]
WantedBy=default.target
