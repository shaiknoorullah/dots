-- ───────────────────────────────────────────────────────────────────────
--  Hyprland 0.56 (Lua config) — ported from i3 (84 keybinds), Dracula,
--  JetBrainsMono. Colors templated from .chezmoidata.yaml via chezmoi.
--  hyprlang .conf was dropped in 0.55 (verified on 0.56.2) — this is the live config.
--  https://wiki.hypr.land/Configuring/
-- ───────────────────────────────────────────────────────────────────────

local mod  = "SUPER"

-- ── Environment (PATH/XDG from $HOME; GPU block templated) ────────────
-- hl.env does not go through a shell, so $HOME is read via os.getenv.
-- Nix profile first so its entries win; this PATH is inherited by every exec_cmd.
local HOME = os.getenv("HOME")
{{- if eq .gpu "nixos" }}
hl.env("PATH", HOME .. "/.local/bin:" .. HOME .. "/.nix-profile/bin:/run/wrappers/bin:/run/current-system/sw/bin")
hl.env("XDG_DATA_DIRS", HOME .. "/.nix-profile/share:/run/current-system/sw/share")
{{- else }}
hl.env("PATH", HOME .. "/.local/bin:" .. HOME .. "/.nix-profile/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/bin")
hl.env("XDG_DATA_DIRS", HOME .. "/.nix-profile/share:/usr/local/share:/usr/share")
{{- end }}
-- default kube cluster (waybar kube module + GUI-launched shells): discovered per machine by
-- kube-discover.sh, so this repo names no cluster. Absent -> KUBECONFIG simply stays unset.
local kube_env = io.open((os.getenv("XDG_CONFIG_HOME") or (HOME .. "/.config")) .. "/dots/kube.env")
if kube_env then
  for line in kube_env:lines() do
    local v = line:match("^export KUBECONFIG=(.+)$")
    if v then hl.env("KUBECONFIG", v) end
  end
  kube_env:close()
end
hl.env("ELECTRON_OZONE_PLATFORM_HINT", "auto")
hl.env("QT_QPA_PLATFORMTHEME", "gtk3")  -- Qt follows GTK (dark); see environment.d/30-appearance.conf
{{- if eq .gpu "nvidia" }}
hl.env("LIBVA_DRIVER_NAME", "nvidia")
hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")
hl.env("NVD_BACKEND", "direct")
{{- end }}

-- ── Monitors (catch-all: preferred mode, auto position) ────────────────
-- preferred (1080p60): the BenQ GW2790 is visibly soft at 100 Hz over HDMI. 1080p60 is a CEA mode, for which the
-- NVIDIA driver sends limited-range RGB (washed-out blacks): set the monitor's HDMI RGB range to full (0-255) instead.
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1 })

-- ── Appearance — Dracula, glass ON ─────────────────────────────────────
hl.config({
  general = {
    gaps_in   = 6,
    gaps_out  = 3,
    border_size = 2,
    ["col.active_border"]   = { colors = { "rgb(bd93f9)", "rgb(ff79c6)" }, angle = 45 },
    ["col.inactive_border"] = "rgb(232336)",
    layout = "dwindle",
    resize_on_border = true,
    allow_tearing = false,
  },
  decoration = {
    rounding = 12,
    dim_strength = 0.6,             -- how much dim_around darkens the background
    blur = {
      enabled = true,
      size = 5,
      passes = 2,
      new_optimizations = true,
      ignore_opacity = true,
    },
    shadow = {
      enabled = true,
      range = 14,
      color = "rgba(00000073)",
    },
    active_opacity = 0.82,
    inactive_opacity = 0.70,
  },
  animations = {
    enabled = true,                 -- curves/leaves defined below (hl.curve/hl.animation)
  },
  input = {
    kb_layout = "us",
    follow_mouse = 1,
    accel_profile = "flat",
  },
  misc = {
    disable_hyprland_logo = true,
    disable_splash_rendering = true,
    -- Honour xdg-activation: an app that asks to be raised gets focus, and Hyprland switches to its
    -- workspace. Required for notification clicks to reach the app that sent them — Slack, Electron
    -- apps and browsers all raise themselves this way, and with this false Hyprland silently ignored
    -- the request, so clicking a Slack notification did nothing. The trade-off is accepted: an app
    -- can now pull focus when it asks to.
    focus_on_activate = true,
  },
  dwindle = {
    preserve_split = true,
    force_split = 2,
  },
  cursor = {
    no_hardware_cursors = true,     -- avoids garbled cursor on nvidia
  },
})

-- ── Animations — fluid Dracula morphs (springy popin + smooth slides) ──
hl.curve("smooth",  { type = "bezier", points = { {0.16, 1.0}, {0.3, 1.0} } })
hl.curve("snappy",  { type = "bezier", points = { {0.05, 0.9}, {0.1, 1.05} } })
hl.curve("springy", { type = "spring", mass = 1, stiffness = 190, dampening = 21 })

hl.animation({ leaf = "windows",    enabled = true, speed = 6, spring = "springy", style = "popin 80%" })
hl.animation({ leaf = "windowsOut", enabled = true, speed = 6, bezier = "snappy",  style = "popin 80%" })
hl.animation({ leaf = "fade",       enabled = true, speed = 7, bezier = "smooth" })
hl.animation({ leaf = "workspaces", enabled = true, speed = 7, bezier = "snappy",  style = "slide" })
hl.animation({ leaf = "border",     enabled = true, speed = 8, bezier = "smooth" })
hl.animation({ leaf = "layers",     enabled = true, speed = 6, bezier = "snappy",  style = "slide" })

-- ── Window rules (workspace pinning + floats) ──────────────────────────
-- Keep terminals fully opaque (don't translucent them via the global opacity).
hl.window_rule({ match = { class = "^(com[.]mitchellh[.]ghostty)$" }, opaque = true })

hl.window_rule({ match = { class = "^(zen-alpha|zen-beta|zen-browser|firefox|Firefox)$" }, workspace = "2 silent" })
hl.window_rule({ match = { class = "^([Cc]ode|code-oss|Cursor)$" },                    workspace = "3 silent" })
hl.window_rule({ match = { class = "^([Ss]lack)$" },                                   workspace = "4 silent" })
hl.window_rule({ match = { class = "^([Tt]hunderbird)$" },                             workspace = "5 silent" })
hl.window_rule({ match = { class = "^([Oo]bsidian)$" },                                workspace = "7 silent" })
hl.window_rule({ match = { class = "^([Ss]potify|YoutubeMusic|youtube-music)$" },      workspace = "8 silent" })
hl.window_rule({ match = { class = "^([Pp]avucontrol|[Nn]m-connection-editor|file-roller)$" }, float = true })
hl.window_rule({ match = { class = "^(zen-tab-switcher)$" },                           float = true, center = true })

-- ── The dots.* popup family ────────────────────────────────────────────
-- Every launcher, picker and TUI panel in this setup is a ghostty instance started with
-- --class=dots.<thing> (otter, yazi, clipse, wallpaper, keyhelp, tasktui, ops, capture,
-- salahpick, bluetuith). They are all the SAME kind of object -- a modal overlay you open,
-- answer and dismiss -- so everything they share is stated ONCE here, and the only thing
-- left per popup is its size.
--
-- opaque is the load-bearing one. The rule above only exempts class com.mitchellh.ghostty
-- from the global active/inactive_opacity, and these windows do not carry that class -- so
-- a popup was being faded to 0.82 on top of the 0.85 its own config already asks for,
-- landing near 0.70 and washing out every list it drew. `opaque` only touches Hyprland's
-- compositing alpha, so ghostty's own 0.85 and its background image survive intact.
--
-- dim_around is what makes them read as modal: the desktop behind recedes
-- (decoration.dim_strength) and the popup is the only lit thing on screen.
--
-- stay_focused is deliberately NOT here, and the note on the retired focus-panel rules
-- below says why: a window that refuses to give up focus also blocks grim/slurp, so a
-- screenshot of a popup becomes impossible. Esc already closes every one of these.
-- NOTE the `.*$`: Hyprland matches a class rule against the WHOLE class, so "^(dots[.])"
-- matches only a window whose class is literally "dots." and therefore matched nothing --
-- every popup lost float/center/dim_around/opaque at once and opened as a tiled window.
-- Every other rule in this file is anchored the same way (see com[.]mitchellh[.]ghostty).
hl.window_rule({ match = { class = "^(dots[.].*)$" }, float = true })
hl.window_rule({ match = { class = "^(dots[.].*)$" }, center = true })
hl.window_rule({ match = { class = "^(dots[.].*)$" }, dim_around = true })
hl.window_rule({ match = { class = "^(dots[.].*)$" }, opaque = true })
-- Per-popup SIZE is the only thing left that is genuinely per popup: a one-line capture
-- box and a file manager do not want the same rectangle. Nothing else varies, which is the
-- point -- these used to be eleven separate four-to-six-line blocks, each repeating
-- float/center/dim_around/opaque and each free to disagree, and they did: rounding was 5 on
-- five of them and the global 12 on the rest, so otter and keyhelp had visibly different
-- corners. Rounding is not listed here at all now; decoration.rounding (12) is the panel
-- radius the whole desktop uses, swaync and the OSD included.
for class, size in pairs({
  ["dots[.]block"]     = "820 420",    -- the blocking panel: a question plus its escape route
  ["dots[.]capture"]   = "700 120",    -- one-line capture prompt
  ["dots[.]salahpick"] = "560 320",    -- four-item picker
  ["dots[.]otter"]     = "400 300",    -- the launcher itself
  ["dots[.]tmuxfzf"]   = "760 420",    -- tmux-fzf/pass/ssh menus (scripts/fzf-float.sh)
  ["dots[.]bluetuith"] = "720 520",
  ["dots[.]clipse"]    = "720 520",
  ["dots[.]keyhelp"]   = "820 760",    -- a document, not a prompt
  ["dots[.]ops"]       = "1000 560",
  ["dots[.]wallpaper"] = "1100 620",   -- wide: chafa previews
  ["dots[.]tasktui"]   = "1100 720",
  ["dots[.]yazi"]      = "1300 820",   -- a document, not a prompt
}) do
  hl.window_rule({ match = { class = "^(" .. class .. ")$" }, size = size })
end

-- ── dots.block: the ONE window allowed to take the keyboard ───────────
-- Everything above says stay_focused is deliberately absent, and that still holds for
-- every launcher and picker: a window that will not release focus also blocks grim/slurp,
-- so a screenshot of it becomes impossible, and Esc already dismisses all of them.
--
-- dots.block is the exception, and it is the exception on purpose. It is the timetrack
-- enforcement panel: a question that has to be answered before the day's record can be
-- defended. If Esc dismissed it, it would be dismissed -- which is the entire failure mode
-- the system exists to correct. So the compositor enforces the grab (stay_focused) and
-- killactive is refused for the panel's whole lifetime (no_close_for).
--
-- no_close_for, NOT no_close. There is no no_close in 0.56.2 -- verified against the
-- running compositor, which is also how severe the mistake would have been:
--
--   hyprctl eval 'hl.window_rule({ ..., no_close = true })'
--     -> error: hl.window_rule: unknown field 'no_close'
--   hyprctl eval 'hl.window_rule({ ..., no_close_for = 5000 })'
--     -> ok
--
-- An unknown field is a HARD ERROR in a Lua config, not an ignored line, so the wrong key
-- would not have quietly failed to block anything -- it would have taken the whole
-- hyprland.lua down at the next login.
--
-- 600000 ms is deliberately the same number as timetrack-panel's RuntimeMaxSec=600: the
-- window stops being unclosable at exactly the instant PID 1 would have killed it anyway,
-- so the protection can never outlive the panel it was protecting. tests/lint.sh pins the
-- two together.
--
-- That is a dangerous pair, and NOTHING may create such a window without the dead-man's
-- switch already running. `timetrack-panel` refuses to launch while
-- timetrack-deadman.timer is inactive, and three independent escapes exist on top of it:
--
--   touch ~/.config/timetrack/PANIC   reaped within 30s; tracking continues
--   hyprctl reload                    re-reads this file and drops the rules
--   systemctl --user stop timetrack-panel-<id>.service
--
-- The panel prints all three on itself, because remembering them is not a plan.
hl.window_rule({ match = { class = "^(dots[.]block)$" }, stay_focused = true })
hl.window_rule({ match = { class = "^(dots[.]block)$" }, no_close_for = 600000 })

-- (removed the title="^(focus-panel)$" block: float/center/size/dim_around/stay_focused/
--  opaque for a window nothing has created since the caelestia focus panel was replaced by
--  dots.tasktui. Its whole intent -- a centred, dimmed-around, de-faded modal -- is what the
--  dots.* rules above now give every popup, minus the stay_focused that would have broken
--  screenshots. Also removed earlier: stale title="wallpaper-picker" rules, same story.)

-- ── Layer rules: real glass on the shell surfaces (compositor blur) ────
-- waybar and swaync both draw themselves translucent (alpha(@bg, 0.78) / 0.86 in their
-- stylesheets) specifically so these rules have something to blur; without the blur they
-- would just be see-through, which is not the same thing and reads as cheap. swaync owns
-- two namespaces -- the control centre and the toast window -- and both need it, or a toast
-- and the panel it lands in are visibly different materials.
-- ignore_alpha: a layer SURFACE is bigger than the thing drawn on it -- swaync's panel
-- occupies a full-height column and paints a card near the top -- so blurring the surface
-- also blurs the transparent remainder, leaving a hard rectangular seam over the wallpaper.
-- The threshold makes the compositor skip pixels below that alpha, so only the actual
-- panel gets glass.
hl.layer_rule({ match = { namespace = "waybar" },                      blur = true, ignore_alpha = 0.3 })
hl.layer_rule({ match = { namespace = "swaync-control-center" },       blur = true, ignore_alpha = 0.3 })
hl.layer_rule({ match = { namespace = "swaync-notification-window" },  blur = true, ignore_alpha = 0.3 })
hl.layer_rule({ match = { namespace = "swayosd" },                     blur = true, ignore_alpha = 0.3 })
-- The Quickshell shell (dots-shell use quickshell): one namespace per surface, frozen by
-- docs/contracts/qml-api.md. Same glass, same threshold as the waybar/swaync rules above.
hl.layer_rule({ match = { namespace = "qs-bar" },      blur = true, ignore_alpha = 0.3 })
hl.layer_rule({ match = { namespace = "qs-notif" },    blur = true, ignore_alpha = 0.3 })
hl.layer_rule({ match = { namespace = "qs-osd" },      blur = true, ignore_alpha = 0.3 })
hl.layer_rule({ match = { namespace = "qs-panel" },    blur = true, ignore_alpha = 0.3 })
hl.layer_rule({ match = { namespace = "qs-overview" }, blur = true, ignore_alpha = 0.3 })
-- slurp's region overlay: no slide-out. grim fires the moment slurp exits, and a layer still
-- sliding away was captured as a grey band across the screenshot.
hl.layer_rule({ match = { namespace = "selection" }, no_anim = true })

-- ── Autostart ──────────────────────────────────────────────────────────
hl.on("hyprland.start", function()
  -- The user manager lingers across logouts: replace a previous session's env (e.g. XDG_CURRENT_DESKTOP=GNOME) and drop
  -- portals started under it, else xdg-desktop-portal waits on the GNOME backend and every GTK app stalls 25 s.
  hl.exec_cmd("sh -c 'dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE HYPRLAND_INSTANCE_SIGNATURE; systemctl --user stop xdg-desktop-portal xdg-desktop-portal-gnome xdg-desktop-portal-gtk xdg-desktop-portal-hyprland; systemctl --user reset-failed'")
  -- bar + notifications + OSD: waybar/swaync/swayosd-server by default, or the Quickshell shell
  -- when `dots-shell use quickshell` has been run (see ~/.local/state/dots-shell/active).
  -- dots-shell passes swayosd its stylesheet with -s; without it the OSD renders stock GTK.
  hl.exec_cmd("~/.local/bin/dots-shell start")
  hl.exec_cmd("~/.local/bin/wallpaper --restore")
  hl.exec_cmd("clipse -listen")   -- clipboard-history daemon for the clipse TUI
  hl.exec_cmd("systemctl --user start awatcher.service")     -- ActivityWatch window+AFK watcher (needs Wayland env)
  hl.exec_cmd("sh -c '[ -e {{ .chezmoi.homeDir }}/.nix-profile/lib/libhyprcapture.so ] && hyprctl plugin load {{ .chezmoi.homeDir }}/.nix-profile/lib/libhyprcapture.so'")  -- HyprCapture plugin (Nix-built against this Hyprland); skipped if absent
  hl.exec_cmd("hypridle")                                   -- idle → lock/screen-off
  hl.exec_cmd("systemctl --user start hyprpolkitagent.service")
  -- pinned apps (rules above place them on their workspaces)
  hl.exec_cmd("ghostty")
  hl.exec_cmd("zen-browser")
  hl.exec_cmd("code")
  hl.exec_cmd("thunderbird")  -- nix TB (resolved via PATH from the env block: NOT a system snap); window rule above pins it to ws5
  hl.exec_cmd("[workspace special:tasks silent] ghostty --class=dots.tasktui --gtk-single-instance=false --config-file={{ .chezmoi.homeDir }}/.config/ghostty/popup-tasktui -e ~/.local/bin/tw-tui")  -- open the daily driver at login (clock-in / resume)
end)

